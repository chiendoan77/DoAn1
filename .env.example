# MySQL port exposed on the local host (default 3306 if omitted)
MYSQL_PORT=

# RabbitMQ credentials
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# Grafana credentials
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# JWT Keypair (Generate with PowerShell RSA 3072-bit as described in docs/SECURITY.md)
# JWT_PRIVATE_KEY_BASE64=
# JWT_PUBLIC_KEY_BASE64=
